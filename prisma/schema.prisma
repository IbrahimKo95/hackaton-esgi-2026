// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  firstName     String?
  lastName      String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  phone         String?
  subscribed    Boolean   @default(false)
  createdAt     DateTime  @default(now())

  roleId Int?
  role   Role? @relation(fields: [roleId], references: [id])

  accounts          Account[]
  sessions          Session[]
  reservations      Reservation[]
  hotelReservations HotelReservation[]
  reviews           Review[]

  userPromotions UserPromotion[]

  userBadges UserBadge[]
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  type  Int
  users User[]
}

model Address {
  id         Int    @id @default(autoincrement())
  street     String
  city       String
  country    String
  postalCode String
  latitude   Float?
  longitude  Float?

  restaurants Restaurant[]
  hotels      Hotel[]
}

model Chef {
  id          Int     @id @default(autoincrement())
  name        String
  biography   String?
  photoUrl    String?
  nationality String?

  restaurants Restaurant[]
}

model Restaurant {
  id          Int      @id @default(autoincrement())
  name        String
  link        String?
  menu        String?
  priceRange  Int
  cuisineType String
  schedule    String?
  seatingCap  Int?
  imageUrl    String?
  ambiance    String?
  createdAt   DateTime @default(now())

  addressId Int
  address   Address @relation(fields: [addressId], references: [id])

  chefId Int?
  chef   Chef? @relation(fields: [chefId], references: [id])

  distinctions  Distinction[]
  reservations  Reservation[]
  tags          RestaurantTag[]
  VerticalMedia VerticalMedia[]

  promotions Promotion[]
}

model Distinction {
  id   Int             @id @default(autoincrement())
  type DistinctionType
  year Int

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

enum DistinctionType {
  ONE_STAR
  TWO_STARS
  THREE_STARS
  BIB_GOURMAND
  GREEN_STAR
  RECOMMENDED
}

model Tag {
  id    Int    @id @default(autoincrement())
  label String @unique

  restaurants RestaurantTag[]
}

model RestaurantTag {
  restaurantId Int
  tagId        Int

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tag        Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([restaurantId, tagId])
}

model Review {
  id      Int        @id @default(autoincrement())
  date    DateTime   @default(now())
  comment String?
  rating  Int
  type    ReviewType

  userId String
  user   User   @relation(fields: [userId], references: [id])

  reservation      Reservation?
  hotelReservation HotelReservation?
}

enum ReviewType {
  RESTAURANT
  HOTEL
}

model Reservation {
  id         Int      @id @default(autoincrement())
  date       DateTime
  bookedAt   DateTime @default(now())
  guestCount Int      @default(1)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  reviewId Int?    @unique
  review   Review? @relation(fields: [reviewId], references: [id])
}

model Hotel {
  id         Int     @id @default(autoincrement())
  name       String
  imageUrl   String?
  starRating Int     @default(0)

  addressId Int
  address   Address @relation(fields: [addressId], references: [id])

  rooms             HotelRoom[]
  hotelReservations HotelReservation[]
}

model Room {
  id            Int     @id @default(autoincrement())
  bedCount      Int
  area          Float?
  hasBalcony    Boolean @default(false)
  photo         String?
  type          String?
  pricePerNight Float

  hotels            HotelRoom[]
  hotelReservations HotelReservation[]
}

model HotelRoom {
  hotelId Int
  roomId  Int

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  room  Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([hotelId, roomId])
}

model HotelReservation {
  id           Int      @id @default(autoincrement())
  checkIn      DateTime
  checkOut     DateTime
  breakfast    Boolean  @default(false)
  lateCheckout Boolean  @default(false)
  createdAt    DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  hotelId Int
  hotel   Hotel @relation(fields: [hotelId], references: [id])

  roomId Int
  room   Room @relation(fields: [roomId], references: [id])

  reviewId Int?    @unique
  review   Review? @relation(fields: [reviewId], references: [id])
}

model VerticalMedia {
  id          Int      @id @default(autoincrement())
  url         String
  description String?
  createdAt   DateTime @default(now())

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Badge {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  description String?
  imageUrl    String?
  category    BadgeCategory
  threshold   Int
  promotionId Int?
  promotion   Promotion?    @relation(fields: [promotionId], references: [id])

  userBadges UserBadge[]
}

enum BadgeCategory {
  RESERVATION // X réservations effectuées
  EXPLORER // X villes différentes visitées
  LOYALTY // X fois dans le même restaurant
  REVIEWER // X avis laissés
}

model UserBadge {
  id         Int      @id @default(autoincrement())
  obtainedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  badgeId Int
  badge   Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

model Promotion {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?
  discountPercent Int // 5, 10, 15...
  code            String   @unique
  validFrom       DateTime
  validUntil      DateTime
  isActive        Boolean  @default(true)

  restaurantId Int?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])

  userPromotions UserPromotion[]

  badges Badge[]
}

model UserPromotion {
  id         Int       @id @default(autoincrement())
  unlockedAt DateTime  @default(now())
  usedAt     DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  promotionId Int
  promotion   Promotion @relation(fields: [promotionId], references: [id])

  @@unique([userId, promotionId])
}
